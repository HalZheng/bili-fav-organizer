#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
B站登录凭证模板。

使用方法:
  1. 复制本文件为 bili_secrets.py:  cp bili_secrets.py.example bili_secrets.py
  2. 填入你自己的凭证（bili_secrets.py 已被 .gitignore 忽略，不会被提交）

也可以不使用本文件，直接设置环境变量（优先级更高）:
  BILI_SESSDATA / BILI_BILI_JCT / BILI_BUVID3 / BILI_DEDEUSERID

凭证获取方式（浏览器登录B站后）:
  F12 → Application(应用) → Cookies → https://www.bilibili.com
  - SESSDATA:   Cookie 中的 SESSDATA（必填，爬取与整理都需要）
  - BILI_JCT:   Cookie 中的 bili_jct（涉及收藏夹移动/删除等写操作时必填）
  - BUVID3:     Cookie 中的 buvid3（可选，一般可留空）
  - DedeUserID: Cookie 中的 DedeUserID，即你的B站UID（建议填写）

⚠️ 切勿将填好的 bili_secrets.py 提交到 git 或分享给他人。
"""

# Cookie 中的 SESSDATA（必填）
SESSDATA = ""

# Cookie 中的 bili_jct（写操作必填：移动/删除收藏夹视频）
BILI_JCT = ""

# Cookie 中的 buvid3（可选）
BUVID3 = ""

# 你的B站UID，Cookie 中的 DedeUserID
DedeUserID = ""

# ── 可选: LLM 分类配置（不用 LLM 分类可留空）──
# LLM_API_KEY = ""
# LLM_API_URL = "https://api.deepseek.com/v1/chat/completions"
# LLM_MODEL = "deepseek-v4-flash"
